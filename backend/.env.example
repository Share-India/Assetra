# ==============================================================================
# FAR Replacement Value Calculator - Environment Configuration Template
# Copy this file to .env and provide your actual configuration values.
# ==============================================================================

# Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Server & Upload Limits
PORT=8000
MAX_UPLOAD_MB=25

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=far_app
DB_USER=far_user
DB_PASSWORD=your_mysql_password_here

# Authentication & Security
JWT_SECRET=
RETENTION_DAYS=
BACKUP_RETENTION_DAYS=
ALLOWED_EMAIL_DOMAINS=
PASSWORD_MIN_LENGTH=
REMEMBER_ME_DAYS=7
IDLE_TIMEOUT_MINUTES=30

# Public App, Google Auth & Email
ENV=
FRONTEND_URL=
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_TIMEOUT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_SENDER_NAME=Share India Insurance
MAIL_REPLY_TO=
TURNSTILE_SECRET=

# Feature Flags & Limits
ADMIN_EMAIL=communication.ins@shareindia.co.in
REQUIRE_ADMIN_APPROVAL=false
ADMIN_CAN_VIEW_ROWS=false
MAX_ROWS_PER_FILE=30000
DAILY_ANALYSES_PER_USER=5
MONTHLY_GEMINI_CALLS_PER_USER=500
MONTHLY_GEMINI_CALLS_GLOBAL=20000

# Logging
LOG_LEVEL=

