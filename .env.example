# FAR Replacement Value Calculator - Root Environment Configuration Example
# Copy this file to .env in root or see backend/.env.example and frontend/.env.example

# Backend Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=100
PORT=8000
LOG_LEVEL=INFO

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=far_app
DB_USER=far_user
DB_PASSWORD='your_mysql_password_here'

# Authentication & Security
JWT_SECRET=your_long_random_jwt_secret_at_least_40_chars_here
RETENTION_DAYS=180
ALLOWED_EMAIL_DOMAINS=shareindia.com,company.com
REMEMBER_ME_DAYS=7
IDLE_TIMEOUT_MINUTES=30

# Frontend Settings
VITE_API_BASE_URL=http://127.0.0.1:8000
